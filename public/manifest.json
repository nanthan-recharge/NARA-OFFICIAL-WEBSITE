{
  "id": "/",
  "name": "NARA - National Aquatic Resources Research and Development Agency",
  "short_name": "NARA",
  "description": "Official Sri Lanka government web app for aquatic resources research, public services, notices, and digital library access.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#f8fafc",
  "theme_color": "#003d7a",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": ["government", "education", "science"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Government Services",
      "short_name": "Services",
      "description": "Open NARA public services",
      "url": "/government-services-portal",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Digital Library",
      "short_name": "Library",
      "description": "Search NARA publications and research records",
      "url": "/library",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Research Divisions",
      "short_name": "Divisions",
      "description": "Explore NARA research and supporting divisions",
      "url": "/divisions",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "News and Notices",
      "short_name": "News",
      "description": "Read NARA public notices and updates",
      "url": "/nara-news-updates-center",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+nara",
      "url": "/?action=%s"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 420
  }
}
