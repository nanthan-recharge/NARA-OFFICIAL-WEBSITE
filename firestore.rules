rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isKnownAdminRole(role) {
      return role in [
        'system_admin',
        'director_general',
        'deputy_director',
        'division_head',
        'senior_researcher',
        'research_officer',
        'technical_officer',
        'admin_staff',
        'support_staff'
      ];
    }

    function hasActiveAdminProfile(uid) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/adminProfiles/$(uid)) &&
             get(/databases/$(database)/documents/adminProfiles/$(uid)).data.email == request.auth.token.email &&
             get(/databases/$(database)/documents/adminProfiles/$(uid)).data.is_active != false &&
             !(get(/databases/$(database)/documents/adminProfiles/$(uid)).data.status in ['suspended', 'terminated', 'retired']) &&
             isKnownAdminRole(get(/databases/$(database)/documents/adminProfiles/$(uid)).data.role);
    }

    function isAdmin() {
      return hasActiveAdminProfile(request.auth.uid);
    }

    function isSystemAdmin() {
      return hasActiveAdminProfile(request.auth.uid) &&
             get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.role in ['system_admin', 'director_general'];
    }
    
    function isOwner(uid) {
      return request.auth != null && 
             request.auth.uid == uid;
    }

    function hasAdminCustomPermission(permission) {
      return hasActiveAdminProfile(request.auth.uid) &&
             (get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.customPermissions is list) &&
             permission in get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.customPermissions;
    }

    function hasAdminRole(roles) {
      return hasActiveAdminProfile(request.auth.uid) &&
             get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.role in roles;
    }

    function hasAdminSectionAccess(permission, defaultRoles) {
      return isSystemAdmin() || hasAdminRole(defaultRoles) || hasAdminCustomPermission(permission);
    }

    function canManageDivisions() {
      return hasAdminSectionAccess('manage_divisions', ['deputy_director', 'division_head']);
    }

    function canManageNews() {
      return hasAdminSectionAccess('manage_news', ['deputy_director', 'division_head', 'admin_staff']);
    }

    function canManageContent() {
      return hasAdminSectionAccess('manage_content', ['deputy_director', 'division_head', 'senior_researcher']);
    }

    function canManageHeroImages() {
      return hasAdminSectionAccess('manage_hero_images', ['deputy_director', 'admin_staff']);
    }

    function canManageVacancies() {
      return hasAdminSectionAccess('manage_vacancies', ['deputy_director', 'admin_staff']);
    }

    function canManageScientistSessions() {
      return hasAdminSectionAccess('manage_scientist_sessions', ['deputy_director', 'admin_staff']);
    }

    function canManageMedia() {
      return hasAdminSectionAccess('manage_media', ['deputy_director', 'division_head', 'admin_staff']);
    }

    function canManageResearchData() {
      return hasAdminSectionAccess('manage_research_data', ['deputy_director', 'division_head', 'senior_researcher']);
    }

    function canManageProjectPipeline() {
      return hasAdminSectionAccess('manage_project_pipeline', ['deputy_director', 'division_head', 'senior_researcher']);
    }

    function canManageGovernmentServices() {
      return hasAdminSectionAccess('manage_government_services', ['deputy_director', 'division_head', 'admin_staff']);
    }

    function canManageLDA() {
      return hasAdminSectionAccess('manage_lda', ['deputy_director', 'admin_staff']);
    }

    function canManageMaritime() {
      return hasAdminSectionAccess('manage_maritime', ['deputy_director', 'division_head']);
    }

    function canManageBathymetry() {
      return hasAdminSectionAccess('manage_bathymetry', ['deputy_director', 'division_head', 'technical_officer']);
    }

    function canManageIncidents() {
      return hasAdminSectionAccess('manage_incidents', ['deputy_director', 'division_head']);
    }

    function canManageFishAdvisory() {
      return hasAdminSectionAccess('manage_fish_advisory', ['deputy_director', 'division_head']);
    }

    function canManagePodcasts() {
      return hasAdminSectionAccess('manage_podcasts', ['deputy_director', 'admin_staff']);
    }

    function canManageLabData() {
      return hasAdminSectionAccess('manage_lab_data', ['deputy_director', 'division_head', 'senior_researcher', 'technical_officer']);
    }

    function canManageResearchVessels() {
      return hasAdminSectionAccess('manage_research_vessels', ['deputy_director', 'division_head', 'senior_researcher']);
    }

    function canManageAnalytics() {
      return hasAdminSectionAccess('manage_analytics', ['deputy_director']);
    }

    function canManageDataIntegration() {
      return hasAdminSectionAccess('manage_data_integration', ['deputy_director', 'technical_officer']);
    }

    function canManageWaterQuality() {
      return hasAdminSectionAccess('manage_water_quality', ['deputy_director', 'division_head', 'technical_officer']);
    }

    function canManageRecruitment() {
      return hasAdminSectionAccess('manage_recruitment', ['deputy_director', 'admin_staff']);
    }

    function canManageMarketplace() {
      return hasAdminSectionAccess('manage_marketplace', ['deputy_director']);
    }

    function canManagePublicConsultation() {
      return hasAdminSectionAccess('manage_public_consultation', ['deputy_director', 'division_head', 'admin_staff']);
    }

    function canManageUsers() {
      return hasAdminSectionAccess('manage_users', ['deputy_director']);
    }

    function canViewLogs() {
      return isSystemAdmin() ||
             hasAdminRole(['deputy_director', 'division_head', 'admin_staff']) ||
             hasAdminCustomPermission('view_logs');
    }
    
    function isLibrarian() {
      return hasActiveAdminProfile(request.auth.uid) &&
             (
               get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.role in [
                 'system_admin',
                 'director_general',
                 'deputy_director',
                 'division_head',
                 'admin_staff'
               ] ||
               get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.department == 'LIB' ||
               get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.departmentCode == 'LIB' ||
               get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.division == 'LIB' ||
               get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.divisionCode == 'LIB' ||
               hasAdminCustomPermission('manage_library') ||
               hasAdminCustomPermission('manage_catalogue') ||
               hasAdminCustomPermission('manage_circulation') ||
               hasAdminCustomPermission('manage_library_patrons') ||
               hasAdminCustomPermission('manage_library_acquisitions') ||
               hasAdminCustomPermission('review_research')
             );
    }

    function isSelfAdminProfileMaintenance(userId) {
      return isOwner(userId) &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.email == resource.data.email &&
             request.resource.data.role == resource.data.role &&
             request.resource.data.is_active == resource.data.is_active &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'displayName',
               'photoURL',
               'lastLoginAt',
               'updatedAt'
             ]);
    }
    
    function isResearcher() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/libraryUsers/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/libraryUsers/$(request.auth.uid)).data.role == 'researcher';
    }
    
    // ============================================
    // EXISTING COLLECTIONS (Keep these)
    // ============================================
    
    // Division Collections (Public Read Access)
    match /divisions/{divisionId} {
      allow read: if true;
      allow write: if canManageDivisions();
    }
    
    match /divisionContent/{contentId} {
      allow read: if true;
      allow write: if canManageDivisions();
    }
    
    match /divisionImages/{imageId} {
      allow read: if true;
      allow write: if canManageDivisions();
    }

    // News Collection
    match /news/{newsId} {
      // Anyone can read published news articles (public access)
      allow read: if true;
      allow write: if canManageNews();
    }

    // Publications Collection
    match /publications/{publicationId} {
      allow read: if true;
      allow create: if canManageResearchData();
      allow update: if canManageResearchData();
      allow delete: if canManageResearchData();
    }
    
    // Division-related subcollections
    match /divisions/{divisionId}/projects/{projectId} {
      allow read: if true;
      allow write: if canManageDivisions() || canManageResearchData();
    }
    
    match /divisions/{divisionId}/teamMembers/{memberId} {
      allow read: if true;
      allow write: if canManageDivisions();
    }
    
    // Projects Collection
    match /projects/{projectId} {
      allow read: if true;
      allow create: if canManageResearchData();
      allow update: if canManageResearchData();
      allow delete: if canManageResearchData();
    }

    // Project pipeline tracker
    match /research_projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if canManageProjectPipeline() || canManageResearchData();
    }
    
    // Team Members Collection
    match /teamMembers/{memberId} {
      allow read: if true;
      allow write: if canManageDivisions();
    }
    
    // Partners Collection
    match /partners/{partnerId} {
      allow read: if true;
      allow create: if canManageDivisions() || canManageResearchData();
      allow update: if canManageDivisions() || canManageResearchData();
      allow delete: if canManageDivisions() || canManageResearchData();
    }
    
    // Teams Collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if canManageDivisions();
      allow update: if canManageDivisions();
      allow delete: if canManageDivisions();
    }
    
    // Media Images Collection
    match /media_images/{imageId} {
      allow read: if true;
      allow create: if canManageMedia();
      allow update: if canManageMedia();
      allow delete: if canManageMedia();
    }

    // Media Videos Collection
    match /media_videos/{videoId} {
      allow read: if true;
      allow create: if canManageMedia();
      allow update: if canManageMedia();
      allow delete: if canManageMedia();
    }

    // Website publishing collections
    match /hero_images/{imageId} {
      allow read: if true;
      allow create, update, delete: if canManageHeroImages();
    }

    match /vacancies/{vacancyId} {
      allow read: if true;
      allow create, update, delete: if canManageVacancies() || canManageRecruitment();
    }

    // Public job applications submitted via the built-in /vacancies apply form.
    // Anyone may submit (the public applies); only recruitment admins can read,
    // update status, or delete. Applications cannot be edited once submitted.
    match /jobApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if canManageVacancies() || canManageRecruitment();
    }

    match /scientist_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if canManageScientistSessions();
    }

    match /press_releases/{releaseId} {
      allow read: if true;
      allow create, update, delete: if canManageMedia() || canManageNews();
    }

    match /media_assets/{assetId} {
      allow read: if true;
      allow create, update, delete: if canManageMedia();
    }

    match /media_contacts/{contactId} {
      allow read: if true;
      allow create, update, delete: if canManageMedia();
    }

    match /media_stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if canManageMedia();
    }

    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if canManageContent();
    }

    match /pageContent/{pageId} {
      allow read: if true;
      allow create, update, delete: if canManageContent();
    }
    
    // Admin Profiles Collection
    match /adminProfiles/{userId} {
      allow read: if isOwner(userId) || canManageUsers();
      allow create: if isSystemAdmin();
      allow update: if isSystemAdmin() || isSelfAdminProfileMaintenance(userId);
      allow delete: if isSystemAdmin();
    }

    // Staff administration records managed by the secure admin panel
    match /adminUsers/{userId} {
      allow read: if isOwner(userId) || canManageUsers();
      allow create, update, delete: if isSystemAdmin();
    }

    match /userActivityLogs/{logId} {
      allow read: if canViewLogs();
      allow create: if isSystemAdmin();
      allow update, delete: if false;
    }
    
    // Researcher Profiles Collection
    match /researcherProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || canManageResearchData();
      allow delete: if canManageResearchData();
    }
    
    // Government EIA Applications
    match /government_eia_applications/{applicationId} {
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.userId) || canManageGovernmentServices());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      (isOwner(resource.data.userId) || canManageGovernmentServices());
      allow delete: if canManageGovernmentServices();
    }

    // Government Licenses
    match /government_licenses/{licenseId} {
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.userId) || canManageGovernmentServices());
      allow create: if isAuthenticated();
      allow update: if canManageGovernmentServices();
      allow delete: if canManageGovernmentServices();
    }

    // Government services and operational records
    match /applications/{applicationId} {
      allow read: if canManageGovernmentServices() || isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if canManageGovernmentServices();
    }

    match /government_documents/{documentId} {
      allow read: if true;
      allow create, update, delete: if canManageGovernmentServices();
    }

    match /government_compliance_records/{recordId} {
      allow read, write: if canManageGovernmentServices();
    }

    match /government_collaboration_workspaces/{workspaceId} {
      allow read, write: if canManageGovernmentServices();
    }

    match /lda_courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if canManageLDA();
    }

    match /lda_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if canManageLDA();
    }

    match /lda_training_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if canManageLDA();
    }

    match /lda_training_materials/{materialId} {
      allow read: if true;
      allow create, update, delete: if canManageLDA();
    }

    match /lda_projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if canManageLDA();
    }

    match /lda_papers/{paperId} {
      allow read: if true;
      allow create, update, delete: if canManageLDA();
    }

    match /lda_enrollments/{enrollmentId} {
      allow read: if canManageLDA() || isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if canManageLDA();
    }

    match /lda_users/{userId} {
      allow read: if canManageLDA() || isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if canManageLDA() || isOwner(userId);
      allow delete: if canManageLDA();
    }

    match /lda_user_progress/{progressId} {
      allow read: if canManageLDA() || isOwner(resource.data.userId);
      allow create, update: if isAuthenticated();
      allow delete: if canManageLDA();
    }

    match /lda_analytics/{analyticsId} {
      allow read, write: if canManageLDA();
    }

    match /lab_results/{resultId} {
      allow read: if canManageLabData() || isOwner(resource.data.userId);
      allow create, update, delete: if canManageLabData();
    }

    match /lab_service_requests/{requestId} {
      allow read: if canManageLabData() || isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if canManageLabData();
    }

    match /lab_customers/{customerId} {
      allow read, write: if canManageLabData();
    }

    match /lab_certificates/{certificateId} {
      allow read: if canManageLabData() || isOwner(resource.data.userId);
      allow create, update, delete: if canManageLabData();
    }

    match /sample_tracking/{sampleId} {
      allow read, write: if canManageLabData();
    }

    match /test_methodologies/{methodId} {
      allow read: if true;
      allow create, update, delete: if canManageLabData();
    }

    match /research_vessels/{vesselId} {
      allow read: if true;
      allow create, update, delete: if canManageResearchVessels();
    }

    match /vessel_bookings/{bookingId} {
      allow read: if canManageResearchVessels() || isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if canManageResearchVessels();
    }

    match /survey_missions/{missionId} {
      allow read: if true;
      allow create, update, delete: if canManageResearchVessels();
    }

    match /marine_incidents/{incidentId} {
      allow read: if canManageIncidents();
      allow create: if true;
      allow update, delete: if canManageIncidents();
    }

    match /government_emergency_incidents/{incidentId} {
      allow read: if canManageIncidents();
      allow create: if true;
      allow update, delete: if canManageIncidents();
    }

    // User Analytics
    match /analytics/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // Admin Logs
    match /admin_logs/{logId} {
      allow read: if canViewLogs();
      allow create: if isSystemAdmin();
      allow update, delete: if isSystemAdmin();
    }
    
    // ============================================
    // NEW: LIBRARY USER SYSTEM COLLECTIONS
    // ============================================
    
    // Library Users Collection
    match /libraryUsers/{userId} {
      // Users can read their own profile
      // Admins and librarians can read all profiles
      allow read: if isOwner(userId) || isLibrarian();
      
      // Users can create their own profile during registration
      allow create: if isAuthenticated() && 
                       isOwner(userId) &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.email == request.auth.token.email;
      
      // Users can update their own profile
      // Admins and librarians can update any profile
      // Prevent users from changing their role, permissions, or statistics
      allow update: if (isOwner(userId) && 
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.uid == resource.data.uid &&
                        request.resource.data.email == resource.data.email &&
                        request.resource.data.permissions == resource.data.permissions &&
                        request.resource.data.libraryCard == resource.data.libraryCard) ||
                       isLibrarian();
      
      // Only admins can delete user profiles
      allow delete: if isLibrarian() || isSystemAdmin();
    }
    
    // Research Submissions Collection
    match /researchSubmissions/{submissionId} {
      // Public can read approved/published submissions
      // Authors can read their own submissions (any status)
      // Admins can read all submissions
      allow read: if (resource.data.submission.status in ['approved', 'published'] &&
                      resource.data.visibility in ['public', 'institutional']) ||
                     isOwner(resource.data.authorId) ||
                     canManageResearchData() ||
                     isLibrarian();
      
      // Only researchers can create submissions
      allow create: if isAuthenticated() && 
                       isResearcher() && 
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.submission.status == 'pending';
      
      // Authors can update their own submissions if status is 'pending' or 'revision_requested'
      // They cannot change the status themselves
      // Admins can always update (for review/approval)
      allow update: if (isOwner(resource.data.authorId) && 
                        resource.data.submission.status in ['pending', 'revision_requested'] &&
                        request.resource.data.submission.status == resource.data.submission.status) ||
                       isLibrarian();
      
      // Only admins can delete submissions
      allow delete: if isLibrarian() || isSystemAdmin();
    }
    
    // Patron Borrowing Records (for library system integration)
    match /patronBorrowings/{recordId} {
      // Users can read their own borrowing records
      // Admins and librarians can read all records
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.userId) || 
                      isLibrarian());
      
      // Only admins and librarians can create/update borrowing records
      allow write: if isLibrarian();
    }
    
    // User Favorites/Reading Lists
    match /userFavorites/{userId}/items/{itemId} {
      // Users can only access their own favorites
      allow read, write: if isOwner(userId);
    }
    
    // Library Fines
    match /libraryFines/{fineId} {
      // Users can read their own fines
      // Admins and librarians can read all fines
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.userId) ||
                      isLibrarian());
      
      // Only admins and librarians can create/update fines
      allow write: if isLibrarian();
    }
    
    // Library Holds/Reservations
    match /libraryHolds/{holdId} {
      // Users can read their own holds
      // Admins and librarians can read all holds
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.userId) ||
                      isLibrarian());
      
      // Users can create holds for themselves
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.userId);
      
      // Users can cancel their own holds
      // Admins and librarians can update any hold
      allow update: if isOwner(resource.data.userId) ||
                       isLibrarian();
      
      // Users can delete their own holds
      // Admins can delete any hold
      allow delete: if isOwner(resource.data.userId) ||
                       isLibrarian();
    }
    
    // User Notifications
    match /userNotifications/{userId}/notifications/{notificationId} {
      // Users can only access their own notifications
      allow read, write: if isOwner(userId);
    }
    
    // Research Comments/Reviews (optional feature)
    match /researchComments/{commentId} {
      // Anyone can read comments on published research
      allow read: if true;
      
      // Authenticated users can create comments
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own comments
      // Admins can moderate any comment
      allow update, delete: if isOwner(resource.data.userId) || canManageResearchData();
    }
    
    // User Activity Log (optional)
    match /userActivityLog/{userId}/activities/{activityId} {
      // Users can read their own activity log
      // Admins can read all activity logs
      allow read: if isOwner(userId) || isSystemAdmin();
      
      // Only the system (via Cloud Functions) or admins should write to activity logs
      allow write: if isSystemAdmin();
    }
    
    // ============================================
    // RESEARCH EXCELLENCE PORTAL COLLECTIONS
    // ============================================
    
    // Research Content Collection
    match /researchContent/{contentId} {
      // Anyone can read published research content (public access)
      allow read: if true;
      allow create, update, delete: if canManageResearchData();
    }
    
    // User Bookmarks for Research Content
    match /userBookmarks/{userId}/bookmarks/{bookmarkId} {
      // Users can only access their own bookmarks
      allow read, write: if isOwner(userId);
    }
    
    // ============================================
    // ANALYTICS & IMPACT ASSESSMENT COLLECTIONS
    // ============================================
    
    // Impact Assessments - Public read, admin write
    match /impactAssessments/{assessmentId} {
      allow read: if true;
      allow write: if canManageAnalytics();
    }
    
    // Policy Impacts - Public read, admin write
    match /policyImpacts/{impactId} {
      allow read: if true;
      allow write: if canManageAnalytics();
    }
    
    // Stakeholder Feedback - Public read, admin write
    match /stakeholderFeedback/{feedbackId} {
      allow read: if true;
      allow write: if canManageAnalytics();
    }
    
    // Project Outcomes - Public read, admin write
    match /projectOutcomes/{outcomeId} {
      allow read: if true;
      allow write: if canManageAnalytics();
    }
    
    // ROI Calculations - Public read, admin write
    match /roiCalculations/{calculationId} {
      allow read: if true;
      allow write: if canManageAnalytics();
    }

    // ============================================
    // PHYSICAL LIBRARY MANAGEMENT SYSTEM COLLECTIONS
    // ============================================

    // Library Members Collection
    match /library_members/{memberId} {
      // Members can read their own profile, librarians and admins can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.uid ||
                      isLibrarian());

      // Anyone authenticated can create a membership (registration)
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.status == 'active';

      // Members can update their own contact info only
      // Librarians and admins can update any field
      allow update: if (isAuthenticated() &&
                        request.auth.uid == resource.data.uid &&
                        request.resource.data.member_id == resource.data.member_id &&
                        request.resource.data.status == resource.data.status &&
                        request.resource.data.max_books_allowed == resource.data.max_books_allowed) ||
                       isLibrarian();

      // Only admins can delete members
      allow delete: if isLibrarian() || isSystemAdmin();
    }

    // Book Reservations Collection
    match /book_reservations/{reservationId} {
      // Members can read their own reservations, librarians can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.uid ||
                      isLibrarian());

      // Members can create reservations for themselves
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.status == 'pending';

      // Members can cancel their own pending reservations
      // Librarians can update any reservation (mark as ready/collected)
      allow update: if (isAuthenticated() &&
                        request.auth.uid == resource.data.uid &&
                        resource.data.status == 'pending' &&
                        request.resource.data.status == 'cancelled') ||
                       isLibrarian();

      // Only admins can delete reservations
      allow delete: if isLibrarian() || isSystemAdmin();
    }

    // Library Downloads Collection (download/print activity log + student monthly limits)
    match /library_downloads/{downloadId} {
      // Users can read their own download history; librarians can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.userId ||
                      isLibrarian());

      // Authenticated users can log their own downloads
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Activity logs are immutable from the client
      allow update, delete: if isLibrarian() || isSystemAdmin();
    }

    // Book Loans Collection
    match /book_loans/{loanId} {
      // Members can read their own loans, librarians can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.uid ||
                      isLibrarian());

      // Only librarians and admins can create/update loans
      allow create, update: if isLibrarian();

      // Only admins can delete loans
      allow delete: if isLibrarian() || isSystemAdmin();
    }

    // Borrowing History Collection
    match /borrowing_history/{historyId} {
      // Members can read their own history, librarians can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.uid ||
                      isLibrarian());

      // Only librarians and admins can create history records
      allow create: if isLibrarian();

      // Members can add ratings/reviews to their own history
      // Librarians can update any history
      allow update: if (isAuthenticated() &&
                        request.auth.uid == resource.data.uid) ||
                       isLibrarian();

      // Only admins can delete history
      allow delete: if isLibrarian() || isSystemAdmin();
    }

    // Library Fines Collection (Physical Library)
    match /library_fines/{fineId} {
      // Members can read their own fines, librarians can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.uid ||
                      isLibrarian());

      // Only librarians and admins can create/update fines
      allow create, update: if isLibrarian();

      // Only admins can delete fines
      allow delete: if isLibrarian() || isSystemAdmin();
    }

    // Library Inventory Collection
    match /library_inventory/{inventoryId} {
      // Anyone can read inventory (to check availability)
      allow read: if true;

      // Only librarians and admins can update inventory
      allow create, update: if isLibrarian();

      // Only admins can delete inventory records
      allow delete: if isLibrarian() || isSystemAdmin();
    }

    // Library Transactions Collection
    match /library_transactions/{transactionId} {
      // Members can read their own transactions, librarians can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.uid ||
                      isLibrarian());

      // Only librarians and admins can create transactions
      allow create: if isLibrarian();

      // No updates or deletes (audit trail)
      allow update, delete: if false;
    }

    // Library Settings Collection
    match /library_settings/{settingId} {
      // Anyone can read settings (loan periods, fines, etc.)
      allow read: if true;

      // Only admins can update settings
      allow write: if isLibrarian() || isSystemAdmin();
    }

    // ============================================
    // MARITIME SERVICES HUB COLLECTIONS
    // ============================================

    // Maritime Vessels Collection
    match /maritime_vessels/{vesselId} {
      allow read: if true;
      allow create, update, delete: if canManageMaritime();
    }

    // Maritime Ports Collection
    match /maritime_ports/{portId} {
      allow read: if true;
      allow create, update, delete: if canManageMaritime();
    }

    // Maritime Services Collection
    match /maritime_services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if canManageMaritime();
    }

    // Hydrographic Charts Collection
    match /hydro_charts/{chartId} {
      allow read: if true;
      allow create, update, delete: if canManageMaritime() || canManageBathymetry();
    }

    // Hydrographic Chart Requests Collection
    match /hydro_chart_requests/{requestId} {
      allow read: if canManageMaritime() || canManageBathymetry();
      allow create: if true;
      allow update, delete: if canManageMaritime() || canManageBathymetry();
    }

    // Hydrographic Survey Requests Collection
    match /hydro_survey_requests/{requestId} {
      allow read: if canManageMaritime() || canManageBathymetry();
      allow create: if true;
      allow update, delete: if canManageMaritime() || canManageBathymetry();
    }

    // Hydrographic Data Requests Collection
    match /hydro_data_requests/{requestId} {
      allow read: if canManageMaritime() || canManageBathymetry();
      allow create: if true;
      allow update, delete: if canManageMaritime() || canManageBathymetry();
    }

    // Crowd Bathymetry Collection
    match /hydro_crowd_bathymetry/{dataId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if canManageBathymetry();
    }

    // Maritime Permits Collection
    match /maritime_permits/{permitId} {
      allow read: if canManageMaritime();
      allow create: if true;
      allow update, delete: if canManageMaritime();
    }

    // Maritime Alerts Collection
    match /maritime_alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if canManageMaritime() || canManageIncidents();
    }

    // Maritime Safety Reports Collection
    match /maritime_safety_reports/{reportId} {
      allow read: if canManageMaritime() || canManageIncidents();
      allow create: if true;
      allow update, delete: if canManageMaritime() || canManageIncidents();
    }

    // Maritime Bookings Collection
    match /maritime_bookings/{bookingId} {
      allow read: if canManageMaritime();
      allow create: if true;
      allow update, delete: if canManageMaritime();
    }

    // ============================================
    // FISH ADVISORY SYSTEM COLLECTIONS
    // ============================================

    // Fish Advisories Collection
    match /fish_advisories/{advisoryId} {
      // Anyone can read fish advisories (public safety information)
      allow read: if true;
      allow write: if canManageFishAdvisory();
    }

    // Fishing Zones Collection
    match /fishing_zones/{zoneId} {
      // Anyone can read fishing zones (public information)
      allow read: if true;
      allow write: if canManageFishAdvisory();
    }

    // Fish Market Prices Collection
    match /fish_market_prices/{priceId} {
      // Anyone can read fish market prices (public data)
      allow read: if true;
      allow write: if canManageFishAdvisory();
    }

    // Seasonal Restrictions Collection
    match /seasonal_restrictions/{restrictionId} {
      // Anyone can read seasonal restrictions (public information)
      allow read: if true;
      allow write: if canManageFishAdvisory();
    }

    // ============================================
    // PODCAST SYSTEM COLLECTIONS
    // ============================================

    // Podcasts Collection
    match /podcasts/{podcastId} {
      // Anyone can read published podcasts
      allow read: if true;
      allow write: if canManagePodcasts();
    }

    // Podcast Analytics Collections
    match /podcastViews/{viewId} {
      // Anyone can create view records (for tracking)
      allow create: if true;
      // Only admins can read/update/delete view records
      allow read, update, delete: if canManagePodcasts();
    }

    match /podcastEngagements/{engagementId} {
      // Anyone can create engagement records (likes, shares, etc.)
      allow create: if true;
      // Only admins can read/update/delete engagement records
      allow read, update, delete: if canManagePodcasts();
    }

    // ============================================
    // FISH MARKET INTELLIGENCE COLLECTIONS
    // ============================================

    // Scraper Metadata Collection
    match /scraper_metadata/{metadataId} {
      // Anyone can read scraper metadata (last run time, etc.)
      allow read: if true;
      // Only admins and scrapers can write
      allow write: if canManageDataIntegration();
    }

    // Recruitment ATS
    match /recruitment_vacancies/{vacancyId} {
      allow read: if true;
      allow create, update, delete: if canManageRecruitment();
    }

    match /recruitment_applications/{applicationId} {
      allow read: if canManageRecruitment() || isOwner(resource.data.userId);
      allow create: if true;
      allow update, delete: if canManageRecruitment();
    }

    match /recruitment_interviews/{interviewId} {
      allow read, write: if canManageRecruitment();
    }

    // Digital marketplace
    match /marketplace_products/{productId} {
      allow read: if true;
      allow create, update, delete: if canManageMarketplace();
    }

    match /marketplace_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if canManageMarketplace();
    }

    match /marketplace_orders/{orderId} {
      allow read: if canManageMarketplace() || isOwner(resource.data.userId);
      allow create: if true;
      allow update, delete: if canManageMarketplace();
    }

    match /marketplace_payments/{paymentId} {
      allow read, update, delete: if canManageMarketplace();
      allow create: if true;
    }

    match /marketplace_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if canManageMarketplace() || isOwner(resource.data.userId);
    }

    // Public consultation portal
    match /consultations/{consultationId} {
      allow read: if true;
      allow create, update, delete: if canManagePublicConsultation();
    }

    match /consultation_surveys/{surveyId} {
      allow read: if true;
      allow create, update, delete: if canManagePublicConsultation();
    }

    match /consultation_polls/{pollId} {
      allow read: if true;
      allow create, update, delete: if canManagePublicConsultation();
    }

    match /consultation_reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if canManagePublicConsultation();
    }

    match /consultation_comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if canManagePublicConsultation();
    }

    match /consultation_feedback/{feedbackId} {
      allow read: if canManagePublicConsultation();
      allow create: if true;
      allow update, delete: if canManagePublicConsultation();
    }

    match /consultation_votes/{voteId} {
      allow read: if canManagePublicConsultation();
      allow create: if true;
      allow update, delete: if canManagePublicConsultation();
    }

    // Data center integration and data quality
    match /api_integrations/{integrationId} {
      allow read, write: if canManageDataIntegration();
    }

    match /data_sources/{sourceId} {
      allow read, write: if canManageDataIntegration();
    }

    match /sync_jobs/{jobId} {
      allow read, write: if canManageDataIntegration();
    }

    match /sync_schedules/{scheduleId} {
      allow read, write: if canManageDataIntegration();
    }

    match /webhooks/{webhookId} {
      allow read, write: if canManageDataIntegration();
    }

    match /webhook_calls/{callId} {
      allow read, write: if canManageDataIntegration();
    }

    match /transformation_rules/{ruleId} {
      allow read, write: if canManageDataIntegration();
    }

    match /data_quality_rules/{ruleId} {
      allow read, write: if canManageDataIntegration();
    }

    match /data_quality_checks/{checkId} {
      allow read, write: if canManageDataIntegration();
    }

    match /data_visualizations/{visualizationId} {
      allow read: if true;
      allow create, update, delete: if canManageDataIntegration();
    }

    // Water quality and bathymetry
    match /wq_sensors/{sensorId} {
      allow read: if true;
      allow create, update, delete: if canManageWaterQuality();
    }

    match /wq_readings/{readingId} {
      allow read: if true;
      allow create, update, delete: if canManageWaterQuality();
    }

    match /wq_alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if canManageWaterQuality();
    }

    match /wq_thresholds/{thresholdId} {
      allow read: if true;
      allow create, update, delete: if canManageWaterQuality();
    }

    match /bathymetry_datasets/{datasetId} {
      allow read: if true;
      allow create, update, delete: if canManageBathymetry();
    }

    match /bathymetry_visualizations/{visualizationId} {
      allow read: if true;
      allow create, update, delete: if canManageBathymetry();
    }

    // ============================================
    // MARINE SPATIAL PLANNING (MSP) COLLECTIONS
    // ============================================

    // MSP Projects Collection
    match /mspProjects/{projectId} {
      // Allow read if user is a collaborator
      allow read: if isAuthenticated() &&
                     request.auth.token.email in resource.data.collaborators;

      // Allow create if signed in and user is in collaborators list
      allow create: if isAuthenticated() &&
                       request.auth.token.email in request.resource.data.collaborators;

      // Allow update if user is a collaborator
      allow update: if isAuthenticated() &&
                       request.auth.token.email in resource.data.collaborators;

      // Allow delete if user is the owner (userId field)
      allow delete: if isAuthenticated() &&
                       request.auth.token.email == resource.data.userId;
    }

    // MSP Templates Collection
    match /mspTemplates/{templateId} {
      // Everyone can read public templates or their own templates
      allow read: if isAuthenticated() &&
                     (resource.data.isPublic == true ||
                      resource.data.userId == request.auth.token.email);

      // Only authenticated users can create templates
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.token.email;

      // Only owner can update their template
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.token.email;

      // Only owner can delete their template
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.token.email;
    }

    // MSP Activity Log Collection
    match /mspActivityLog/{activityId} {
      // Anyone authenticated can read activity logs
      allow read: if isAuthenticated();

      // Only allow creating activity logs (append-only for audit)
      allow create: if isAuthenticated();

      // No updates or deletes allowed (audit trail integrity)
      allow update, delete: if false;
    }

    // MSP Notifications Collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.token.email;

      // System can create notifications for users
      allow create: if isAuthenticated();

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.token.email;

      // Users can delete their own notifications
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.token.email;
    }

    // ============================================
    // AI API Configuration (Admin Only)
    // ============================================
    match /admin_config/{docId} {
      allow read, write: if isSystemAdmin();
    }
  }
}
