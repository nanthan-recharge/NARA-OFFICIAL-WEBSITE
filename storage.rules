rules_version = '2';

// NARA Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    function hasActiveAdminProfile() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/adminProfiles/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.email == request.auth.token.email &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.is_active != false &&
             !(firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.status in ['suspended', 'terminated']) &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.role in [
               'system_admin',
               'director_general',
               'deputy_director',
               'division_head',
               'senior_researcher',
               'research_officer',
               'technical_officer',
               'admin_staff',
               'support_staff'
             ];
    }

    function isAdmin() {
      return hasActiveAdminProfile();
    }

    function isSafeImageUpload() {
      return request.resource.size < 8 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    function isSafePublicAttachment() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*|application/pdf');
    }

    function isSafeResearchUpload() {
      return request.resource.size < 50 * 1024 * 1024 &&
             request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/.*');
    }

    function isSafePodcastUpload() {
      return request.resource.size < 250 * 1024 * 1024 &&
             request.resource.contentType.matches('video/.*|audio/.*|image/.*');
    }

    // Public assets (logos, images, documents)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Library PDFs and QR codes (FULL PUBLIC READ ACCESS - NO AUTH REQUIRED)
    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeResearchUpload();
    }

    // Tamil translations (FULL PUBLIC READ ACCESS)
    match /pdfs_tamil/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeResearchUpload();
    }

    // Sinhala translations (FULL PUBLIC READ ACCESS)
    match /pdfs_sinhala/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeResearchUpload();
    }

    match /qr-codes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Division images
    match /divisions/{divisionId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImageUpload();
    }

    // Podcast videos
    match /podcasts/{allPaths=**} {
      allow read: if true; // Anyone can view podcasts
      allow write: if isAdmin() && isSafePodcastUpload();
    }

    // News and article images
    match /news/{newsId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImageUpload();
    }

    // Library research submissions
    match /research/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Library research supplementary files
    match /research/{userId}/supplementary/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Research project files
    match /research_projects/{projectId}/{fileName} {
      allow read: if true; // Simplified - all research is public
      allow write: if isAdmin() && isSafeResearchUpload();
    }

    // Publication files
    match /publications/{publicationId}/{fileName} {
      allow read: if true; // Public access
      allow write: if isAdmin() && isSafeResearchUpload();
    }

    // User profile images and documents
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Application documents
    match /applications/{applicationId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isSafePublicAttachment();
      allow update, delete: if isAdmin();
    }

    // Emergency response report attachments
    match /emergency_incidents/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isSafePublicAttachment();
      allow update, delete: if isAdmin();
    }

    match /non_emergency_support/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isSafePublicAttachment();
      allow update, delete: if isAdmin();
    }

    match /environmental_incidents/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isSafePublicAttachment();
      allow update, delete: if isAdmin();
    }

    // Event images and documents
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImageUpload();
    }

    // Temporary uploads
    match /temp/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Administrative files
    match /admin/{fileName} {
      allow read, write: if isAdmin();
    }

    // Library member photos
    match /library_members/{memberId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == memberId;
    }

    // Research content uploads
    match /research-content/{allPaths=**} {
      allow read: if true;  // Anyone can read/download research papers
      allow write: if isAdmin() && isSafeResearchUpload();
    }

    // ============================================
    // MARINE SPATIAL PLANNING (MSP) STORAGE
    // ============================================

    // MSP Photo Attachments
    match /msp-photos/{projectId}/{photoId} {
      // Anyone authenticated can read MSP photos
      allow read: if request.auth != null;

      // Anyone authenticated can upload photos
      allow write: if request.auth != null;

      // Can delete if authenticated
      allow delete: if request.auth != null;
    }

    // MSP Exports (GeoJSON, CSV, PDF, etc.)
    match /msp-exports/{projectId}/{exportId} {
      // Anyone authenticated can read exports
      allow read: if request.auth != null;

      // Anyone authenticated can create exports
      allow write: if request.auth != null;
    }

    // Default deny rule
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
