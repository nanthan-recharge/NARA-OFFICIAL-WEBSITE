rules_version = '2';

// NARA Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    function hasActiveAdminProfile() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/adminProfiles/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.email == request.auth.token.email &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.is_active != false &&
             !(firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.status in ['suspended', 'terminated', 'retired']) &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.role in [
               'system_admin',
               'director_general',
               'deputy_director',
               'division_head',
               'senior_researcher',
               'research_officer',
               'technical_officer',
               'admin_staff',
               'support_staff'
             ];
    }

    function isAdmin() {
      return hasActiveAdminProfile();
    }

    function isSystemAdmin() {
      return hasActiveAdminProfile() &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.role in [
               'system_admin',
               'director_general'
             ];
    }

    function hasAdminRole(roles) {
      return hasActiveAdminProfile() &&
             firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.role in roles;
    }

    function hasAdminCustomPermission(permission) {
      return hasActiveAdminProfile() &&
             (firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.customPermissions is list) &&
             permission in firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.customPermissions;
    }

    function hasAdminSectionAccess(permission, defaultRoles) {
      return isSystemAdmin() || hasAdminRole(defaultRoles) || hasAdminCustomPermission(permission);
    }

    function isLibrarian() {
      return hasActiveAdminProfile() &&
             (
               firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.department == 'LIB' ||
               firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.departmentCode == 'LIB' ||
               hasAdminSectionAccess('manage_library', ['deputy_director', 'division_head', 'admin_staff']) ||
               hasAdminCustomPermission('manage_catalogue') ||
               hasAdminCustomPermission('manage_circulation') ||
               hasAdminCustomPermission('manage_library_patrons') ||
               hasAdminCustomPermission('manage_library_acquisitions') ||
               hasAdminCustomPermission('review_research')
             );
    }

    function canManageUsers() {
      return hasAdminSectionAccess('manage_users', ['deputy_director']);
    }

    function canManageDivisions() {
      return hasAdminSectionAccess('manage_divisions', ['deputy_director', 'division_head']);
    }

    function canManageNews() {
      return hasAdminSectionAccess('manage_news', ['deputy_director', 'division_head', 'admin_staff']);
    }

    function canManageHeroImages() {
      return hasAdminSectionAccess('manage_hero_images', ['deputy_director', 'admin_staff']);
    }

    function canManageMedia() {
      return hasAdminSectionAccess('manage_media', ['deputy_director', 'division_head', 'admin_staff']);
    }

    function canManageResearchData() {
      return hasAdminSectionAccess('manage_research_data', ['deputy_director', 'division_head', 'senior_researcher']);
    }

    function canManageProjectPipeline() {
      return hasAdminSectionAccess('manage_project_pipeline', ['deputy_director', 'division_head', 'senior_researcher']);
    }

    function canManageLabData() {
      return hasAdminSectionAccess('manage_lab_data', ['deputy_director', 'division_head', 'senior_researcher', 'technical_officer']);
    }

    function canManageResearchVessels() {
      return hasAdminSectionAccess('manage_research_vessels', ['deputy_director', 'division_head', 'senior_researcher']);
    }

    function canManageGovernmentServices() {
      return hasAdminSectionAccess('manage_government_services', ['deputy_director', 'division_head', 'admin_staff']);
    }

    function canManageLDA() {
      return hasAdminSectionAccess('manage_lda', ['deputy_director', 'admin_staff']);
    }

    function canManageIncidents() {
      return hasAdminSectionAccess('manage_incidents', ['deputy_director', 'division_head']);
    }

    function canManagePodcasts() {
      return hasAdminSectionAccess('manage_podcasts', ['deputy_director', 'admin_staff']);
    }

    function canManageRecruitment() {
      return hasAdminSectionAccess('manage_recruitment', ['deputy_director', 'admin_staff']);
    }

    function canManageMarketplace() {
      return hasAdminSectionAccess('manage_marketplace', ['deputy_director']);
    }

    function isSafeImageUpload() {
      return request.resource.size < 8 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    function isSafePublicAttachment() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*|application/pdf');
    }

    function isSafeMediaUpload() {
      return request.resource.size < 100 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*|video/.*|application/pdf');
    }

    function isSafeResearchUpload() {
      return request.resource.size < 50 * 1024 * 1024 &&
             request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/.*');
    }

    // Job application documents: PDF, image or Word, up to 10 MB.
    function isSafeApplicationDoc() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    function isSafePodcastUpload() {
      return request.resource.size < 250 * 1024 * 1024 &&
             request.resource.contentType.matches('video/.*|audio/.*|image/.*');
    }

    // Public assets (logos, images, documents)
    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageMedia() && isSafePublicAttachment();
      allow delete: if canManageMedia();
    }

    // Library PDFs and QR codes (FULL PUBLIC READ ACCESS - NO AUTH REQUIRED)
    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow create, update: if (canManageResearchData() || isLibrarian()) && isSafeResearchUpload();
      allow delete: if canManageResearchData() || isLibrarian();
    }

    // Tamil translations (FULL PUBLIC READ ACCESS)
    match /pdfs_tamil/{allPaths=**} {
      allow read: if true;
      allow create, update: if (canManageResearchData() || isLibrarian()) && isSafeResearchUpload();
      allow delete: if canManageResearchData() || isLibrarian();
    }

    // Sinhala translations (FULL PUBLIC READ ACCESS)
    match /pdfs_sinhala/{allPaths=**} {
      allow read: if true;
      allow create, update: if (canManageResearchData() || isLibrarian()) && isSafeResearchUpload();
      allow delete: if canManageResearchData() || isLibrarian();
    }

    match /qr-codes/{allPaths=**} {
      allow read: if true;
      allow create, update: if isLibrarian() && isSafeImageUpload();
      allow delete: if isLibrarian();
    }
    
    // Division images
    match /divisions/{divisionId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageDivisions() && isSafeImageUpload();
      allow delete: if canManageDivisions();
    }

    // Podcast videos
    match /podcasts/{allPaths=**} {
      allow read: if true; // Anyone can view podcasts
      allow create, update: if canManagePodcasts() && isSafePodcastUpload();
      allow delete: if canManagePodcasts();
    }

    // News and article images
    match /news/{newsId}/{fileName} {
      allow read: if true;
      allow create, update: if canManageNews() && isSafeImageUpload();
      allow delete: if canManageNews();
    }

    // Media gallery and press kit assets
    match /media/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageMedia() && isSafeMediaUpload();
      allow delete: if canManageMedia();
    }

    match /media_press/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageMedia() && isSafeMediaUpload();
      allow delete: if canManageMedia();
    }

    // Homepage hero assets
    match /hero-images/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageHeroImages() && isSafeImageUpload();
      allow delete: if canManageHeroImages();
    }

    // Library research submissions
    match /research/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Library research supplementary files
    match /research/{userId}/supplementary/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Research project files
    match /research_projects/{projectId}/{fileName} {
      allow read: if true; // Simplified - all research is public
      allow create, update: if canManageResearchData() && isSafeResearchUpload();
      allow delete: if canManageResearchData();
    }

    // Project pipeline documents
    match /project_documents/{projectId}/{allPaths=**} {
      allow read: if canManageProjectPipeline() || canManageResearchData();
      allow create, update: if (canManageProjectPipeline() || canManageResearchData()) && isSafeResearchUpload();
      allow delete: if canManageProjectPipeline() || canManageResearchData();
    }

    // Publication files
    match /publications/{publicationId}/{fileName} {
      allow read: if true; // Public access
      allow create, update: if canManageResearchData() && isSafeResearchUpload();
      allow delete: if canManageResearchData();
    }

    // User profile images and documents
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Application documents
    match /applications/{applicationId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isSafePublicAttachment();
      allow update, delete: if canManageGovernmentServices();
    }

    // Recruitment and public service attachments
    match /recruitment_documents/{applicationId}/{fileName} {
      allow read: if request.auth != null || canManageRecruitment();
      allow create: if isSafePublicAttachment();
      allow update, delete: if canManageRecruitment();
    }

    // Digital marketplace product assets
    match /marketplace/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageMarketplace() && isSafePublicAttachment();
      allow delete: if canManageMarketplace();
    }

    // LDA learning materials
    match /lda/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageLDA() && isSafeResearchUpload();
      allow delete: if canManageLDA();
    }

    // Laboratory labels and certificates
    match /lab_labels/{fileName} {
      allow read: if canManageLabData();
      allow create, update: if canManageLabData() && isSafeImageUpload();
      allow delete: if canManageLabData();
    }

    // Research vessel photos and files
    match /research_vessels/{vesselId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageResearchVessels() && isSafeMediaUpload();
      allow delete: if canManageResearchVessels();
    }

    // Emergency response report attachments
    match /emergency_incidents/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isSafePublicAttachment();
      allow update, delete: if canManageIncidents();
    }

    match /non_emergency_support/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isSafePublicAttachment();
      allow update, delete: if canManageGovernmentServices();
    }

    match /environmental_incidents/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isSafePublicAttachment();
      allow update, delete: if canManageIncidents();
    }

    // Event images and documents
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow create, update: if canManageNews() && isSafeImageUpload();
      allow delete: if canManageNews();
    }

    // Temporary uploads
    match /temp/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Administrative files
    match /admin/{fileName} {
      allow read, write: if isSystemAdmin();
    }

    // Staff profile photos managed by the unified admin panel
    match /admin-users/{userId}/{allPaths=**} {
      allow read: if hasActiveAdminProfile();
      allow create, update: if canManageUsers() && isSafeImageUpload();
      allow delete: if canManageUsers();
    }

    // Library member photos
    match /library_members/{memberId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == memberId;
    }

    // Research content uploads
    match /research-content/{allPaths=**} {
      allow read: if true;  // Anyone can read/download research papers
      allow create, update: if canManageResearchData() && isSafeResearchUpload();
      allow delete: if canManageResearchData();
    }

    // ============================================
    // MARINE SPATIAL PLANNING (MSP) STORAGE
    // ============================================

    // MSP Photo Attachments
    match /msp-photos/{projectId}/{photoId} {
      // Anyone authenticated can read MSP photos
      allow read: if request.auth != null;

      // Anyone authenticated can upload photos
      allow write: if request.auth != null;

      // Can delete if authenticated
      allow delete: if request.auth != null;
    }

    // MSP Exports (GeoJSON, CSV, PDF, etc.)
    match /msp-exports/{projectId}/{exportId} {
      // Anyone authenticated can read exports
      allow read: if request.auth != null;

      // Anyone authenticated can create exports
      allow write: if request.auth != null;
    }

    // Public job application documents (built-in /vacancies apply form).
    // Anyone may submit; only recruitment admins manage/delete. Reads happen via
    // the tokenized download URL stored on the application record.
    match /job_applications/{vacancyId}/{applicationId}/{fileName} {
      allow read: if request.auth != null || canManageRecruitment();
      allow create: if isSafeApplicationDoc();
      allow update, delete: if canManageRecruitment();
    }

    // Admin-uploaded job-description documents attached to a posting (public).
    match /vacancy_documents/{fileName} {
      allow read: if true;
      allow create, update: if canManageRecruitment() && isSafeApplicationDoc();
      allow delete: if canManageRecruitment();
    }

    // Default deny rule
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
